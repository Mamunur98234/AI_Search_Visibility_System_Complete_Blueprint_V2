# Docker Compose configuration. Copy to .env and replace EVERY placeholder. Never commit .env.
# Generate strong values, e.g.:  openssl rand -base64 32
POSTGRES_PASSWORD=replace-me
AISV_OWNER_PASSWORD=replace-me
AISV_APP_PASSWORD=replace-me
# Fernet key(s): python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEYS=replace-me
# development | production   (production requires SMTP email and HTTPS)
APP_ENV=development
# The URL users open in the browser (used for CSRF origin checks and email links).
PUBLIC_WEB_URL=http://localhost:8080
# Caddy site address: ":8080" for local HTTP, or your domain (e.g. app.example.com) for automatic HTTPS.
SITE_ADDRESS=:8080
HTTP_PORT=8080
ALLOW_SIGNUP=true
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
