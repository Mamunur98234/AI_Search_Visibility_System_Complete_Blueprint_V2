# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
# App connects as a NON-owner role so PostgreSQL row-level security applies.
DATABASE_URL=postgresql+psycopg://aisv_app:change-me-app@localhost:5432/aisv
# Migrations run as the schema owner role.
MIGRATION_DATABASE_URL=postgresql+psycopg://aisv_owner:change-me-owner@localhost:5432/aisv
REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated; first key encrypts, all keys decrypt (rotation).
ENCRYPTION_KEYS=
# Origins allowed to make state-changing requests (CSRF origin check + CORS).
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
ALLOW_SIGNUP=true
# console | file | smtp
EMAIL_BACKEND=console
EMAIL_FILE_DIR=./var/outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
